{
 "prompt": {
  "1": {
   "class_type": "UNETLoader",
   "inputs": {
    "unet_name": "fasth3_omniref_8step_pruned_int8_convrot.safetensors",
    "weight_dtype": "default"
   }
  },
  "2": {
   "class_type": "MiniMaxH3SigmaShift",
   "inputs": {
    "model": ["1", 0],
    "shift_video": 12,
    "shift_audio": 3
   }
  },
  "3": {
   "class_type": "ModelAttentionBackend",
   "inputs": {
    "model": ["2", 0],
    "attention": "comfy kitchen attention"
   }
  },
  "4": {
   "class_type": "BlockSparseAttention",
   "inputs": {
    "model": ["3", 0],
    "start_percent": 0.2,
    "end_percent": 1.0,
    "dense_blocks": "",
    "min_tokens": 12288,
    "extra_tokens": 256,
    "sink_conditioning": "exact_kv_and_rows",
    "verbose": false,
    "selection": "vsa",
    "selection.keep_percent": 10.0
   }
  },
  "5": {
   "class_type": "CLIPLoader",
   "inputs": {
    "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
    "type": "minimax",
    "device": "default"
   }
  },
  "6": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
   }
  },
  "7": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
   }
  },
  "8": {
   "class_type": "RandomNoise",
   "inputs": {
    "noise_seed": "{{SEED}}"
   }
  },
  "9": {
   "class_type": "KSamplerSelect",
   "inputs": {
    "sampler_name": "euler"
   }
  },
  "10": {
   "class_type": "BasicScheduler",
   "inputs": {
    "model": ["4", 0],
    "scheduler": "simple",
    "steps": 8,
    "denoise": 1
   }
  },
  "11": {
   "class_type": "BasicGuider",
   "inputs": {
    "model": ["4", 0],
    "conditioning": ["12", 0]
   }
  },
  "12": {
   "class_type": "MiniMaxH3ReferenceToVideo",
   "inputs": {
    "clip": ["5", 0],
    "vae": ["6", 0],
    "audio_vae": ["7", 0],
    "prompt": "{{PROMPT}}",
    "width": "{{WIDTH}}",
    "height": "{{HEIGHT}}",
    "length": ["13", 1],
    "ref_image_size": "match"
   }
  },
  "13": {
   "class_type": "ComfyMathExpression",
   "inputs": {
    "values.a": ["17", 0],
    "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
   }
  },
  "17": {
   "class_type": "PrimitiveFloat",
   "inputs": {
    "value": "{{SECONDS}}"
   }
  },
  "18": {
   "class_type": "SamplerCustomAdvanced",
   "inputs": {
    "noise": ["8", 0],
    "guider": ["11", 0],
    "sampler": ["9", 0],
    "sigmas": ["10", 0],
    "latent_image": ["12", 1]
   }
  },
  "19": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": ["18", 0],
    "vae": ["6", 0]
   }
  },
  "20": {
   "class_type": "VAEDecodeAudio",
   "inputs": {
    "samples": ["18", 0],
    "vae": ["7", 0]
   }
  },
  "21": {
   "class_type": "CreateVideo",
   "inputs": {
    "images": ["19", 0],
    "audio": ["20", 0],
    "fps": 24,
    "bit_depth": "auto",
    "color_space": "sRGB",
    "codec": "auto"
   }
  },
  "22": {
   "class_type": "SaveVideo",
   "inputs": {
    "video": ["21", 0],
    "filename_prefix": "video/FastH3_OmniRef",
    "format": "mp4"
   }
  }
 },
 "_meta": {
  "mode": "audio_video_r2v",
  "title": "参考图生视频（OmniRef，带声音）",
  "model": "FastH3 OmniRef 8step int8",
  "tips": "最多9张参考图，<Picture i> 引用，124帧≈5s"
 }
}
